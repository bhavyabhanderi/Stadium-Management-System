@model List<StadiumWeb.Models.User>
@{ ViewData["Title"] = "Users"; Layout = "_Layout"; }

<div class="app-wrapper">
    @await Html.PartialAsync("_StaffSidebar")
    <div class="main-content">
        <div class="top-bar"><h4>👥 Registered Users</h4></div>
        <div class="page-body">
            <div class="content-card">
                <div class="content-card-title"><i class="fas fa-users text-purple"></i> All Users (@Model.Count)</div>
                <div class="table-responsive">
                    <table class="table-custom w-100">
                        <thead>
                            <tr><th>User ID</th><th>Name</th><th>Mobile</th><th>Detail</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>#@u.UserId</td>
                                    <td><strong>@u.UserName</strong></td>
                                    <td>@u.MobileNo</td>
                                    <td>
                                        <a href="/Staff/UserDetail/@u.UserId" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
