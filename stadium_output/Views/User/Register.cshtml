@model RegisterViewModel
@{ ViewData["Title"] = "Register"; Layout = "_Layout"; }

<div class="auth-page">
    <div class="auth-card" style="max-width:460px;">
        <div class="text-center mb-3">
            <div class="auth-crest">📝</div>
            <h2>Create Account</h2>
            <p class="subtitle">Join us to book tickets for cricket matches</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
            </div>
        }

        @* <div class="alert alert-info py-2 mb-3" style="font-size:.85rem;">
            <i class="fas fa-info-circle me-1"></i>
            Your <strong>User ID</strong> will be automatically generated and sent to your email after registration.
        </div> *@

        <form asp-action="Register" method="post" id="regForm">
            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fas fa-user me-1 text-muted"></i> Full Name</label>
                <input asp-for="UserName" class="form-control" placeholder="Your full name" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fas fa-lock me-1 text-muted"></i> Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" id="regPassword" />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-mobile-screen-button me-1 text-muted"></i> Mobile Number
                </label>
                <div class="input-group">
                    <span class="input-group-text">+91</span>
                    <input asp-for="MobileNo" class="form-control" placeholder="10-digit mobile"
                           maxlength="10" oninput="this.value=this.value.replace(/\D/g,'')" />
                </div>
                <div class="form-text">Used for stadium entry verification.</div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <i class="fas fa-envelope me-1 text-muted"></i> Email Address
                    <span class="badge bg-primary ms-1" style="font-size:.62rem;">OTP sent here</span>
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="yourname@gmail.com" />
                <div class="form-text"><i class="fas fa-shield-halved text-success"></i> A 6-digit OTP will be sent to this email to verify your account.</div>
            </div>
            <button type="submit" class="btn btn-user w-100 py-2" id="regBtn">
                <i class="fas fa-mobile-screen-button me-2"></i>Send OTP &amp; Continue
            </button>
        </form>

        <hr class="my-3">
        <div class="text-center" style="font-size:.85rem;">
            Already have an account? <a href="/User/Login" style="color:var(--cricket-green);font-weight:600;">Login here</a>
        </div>
        <div class="text-center mt-2"><a href="/" style="font-size:.8rem;color:#aaa;">&#8592; Back to Home</a></div>
    </div>
</div>

<style>
.reg-steps{display:flex;align-items:center;justify-content:center;}
.reg-step{display:flex;align-items:center;gap:.4rem;opacity:.35;}
.reg-step.active{opacity:1;}
.reg-step-num{width:26px;height:26px;border-radius:50%;background:#ccc;color:#fff;font-size:.75rem;font-weight:800;display:flex;align-items:center;justify-content:center;}
.reg-step.active .reg-step-num{background:var(--maroon);box-shadow:0 0 0 3px rgba(123,28,46,.18);}
.reg-step-lbl{font-size:.75rem;font-weight:600;color:var(--charcoal);}
.reg-step-line{flex:1;height:2px;background:#ddd;min-width:28px;max-width:48px;margin:0 .3rem;}
</style>

@section Scripts {
<script>
function togglePwd() {
    var inp = document.getElementById('regPassword');
    var icon = document.getElementById('eyeIcon');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    icon.className = inp.type === 'text' ? 'fas fa-eye-slash' : 'fas fa-eye';
}
document.getElementById('regForm').addEventListener('submit', function() {
    var btn = document.getElementById('regBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending OTP...';
    btn.disabled = true;
});
</script>
}
