@model List<Ticket>
@{ ViewData["Title"] = "My Tickets"; Layout = "_Layout"; }

<div class="app-wrapper">
    @await Html.PartialAsync("_UserSidebar")
    <div class="main-content">
        <div class="top-bar">
            <h4>🎟️ My Tickets</h4>
            <div class="user-info"><i class="fas fa-user-circle"></i><span>@Context.Session.GetString("UserName")</span></div>
        </div>
        <div class="page-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }

            @if (!Model.Any())
            {
                <div class="content-card text-center py-5">
                    <div style="font-size:4rem;">🎫</div>
                    <h5 class="mt-3">No tickets booked yet</h5>
                    <p class="text-muted">Browse upcoming matches and book your first ticket!</p>
                    <a href="/User/BookTicket" class="btn btn-user mt-2"><i class="fas fa-ticket me-2"></i>Book Tickets</a>
                </div>
            }
            else
            {
                <!-- Summary Bar -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <div class="stat-icon green"><i class="fas fa-ticket"></i></div>
                            <div><div class="stat-value">@Model.Count</div><div class="stat-label">Bookings</div></div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <div class="stat-icon blue"><i class="fas fa-hashtag"></i></div>
                            <div><div class="stat-value">@Model.Sum(t => t.NoOfTickets)</div><div class="stat-label">Total Tickets</div></div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <div class="stat-icon gold"><i class="fas fa-indian-rupee-sign"></i></div>
                            <div><div class="stat-value" style="font-size:1.3rem;">₹@Model.Sum(t=>t.TotalPayments).ToString("N0")</div><div class="stat-label">Total Spent</div></div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    @foreach (var t in Model)
                    {
                        var standColor = t.Stand switch {
                            "A" => "#2e7d32", "B" => "#1565c0",
                            "C" => "#6a1b9a", "D" => "#b71c1c", _ => "#555"
                        };
                        var standName = t.Stand switch {
                            "A" => "General", "B" => "Premium",
                            "C" => "Club", "D" => "VIP", _ => ""
                        };
                        <div class="col-md-6">
                            <div class="ticket-card">
                                <div class="ticket-card-header" style="background: linear-gradient(90deg, #0f2044, @standColor);">
                                    <div>
                                        <div class="ticket-card-match">@t.MatchName</div>
                                        <div class="ticket-card-date"><i class="fas fa-calendar me-1"></i>@t.MatchDate &nbsp; <i class="fas fa-clock me-1"></i>@t.MatchTime</div>
                                    </div>
                                    <div>
                                        <div class="ticket-stand-badge">Stand @t.Stand</div>
                                        <div style="font-size:.65rem;text-align:center;opacity:.8;margin-top:.2rem;">@standName</div>
                                    </div>
                                </div>
                                <div class="ticket-card-body">
                                    <div class="ticket-stat-row">
                                        <div class="ticket-stat">
                                            <div class="ticket-stat-val">@t.NoOfTickets</div>
                                            <div class="ticket-stat-lbl">Tickets</div>
                                        </div>
                                        <div class="ticket-stat">
                                            <div class="ticket-stat-val">₹@t.TicketPrice.ToString("N0")</div>
                                            <div class="ticket-stat-lbl">Per Ticket</div>
                                        </div>
                                        <div class="ticket-stat" style="background:#fff0f0;">
                                            <div class="ticket-stat-val" style="color:#b71c1c;">₹@t.TotalPayments.ToString("N0")</div>
                                            <div class="ticket-stat-lbl">Total Paid</div>
                                        </div>
                                    </div>
                                    <div class="ticket-payment-row">
                                        <i class="fas fa-credit-card" style="color:var(--gold);"></i>
                                        <span>@t.PaymentMethod</span>
                                        <span style="margin-left:auto;font-size:.7rem;color:#aaa;">Booking #@t.TicketId</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
