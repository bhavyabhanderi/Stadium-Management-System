@{ ViewData["Title"] = "Change Password"; Layout = "_Layout"; }

<div class="app-wrapper">
    @await Html.PartialAsync("_UserSidebar")
    <div class="main-content">
        <div class="top-bar"><h4>🔑 Change Password</h4></div>
        <div class="page-body">
            <div class="row justify-content-center">
                <div class="col-md-5">
                    <div class="content-card">
                        <div class="content-card-title"><i class="fas fa-key text-warning"></i> Update Password</div>
                        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
                        <form asp-action="ChangePassword" method="post">
                            <div class="mb-3">
                                <label class="form-label">Current Password</label>
                                <input name="oldPassword" type="password" class="form-control" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label">New Password</label>
                                <input name="newPassword" type="password" class="form-control" />
                            </div>
                            <button type="submit" class="btn btn-user w-100 py-2">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
