@{ ViewData["Title"] = "Verify OTP"; Layout = "_Layout"; }

@{
    var mobile    = ViewBag.MobileNo?.ToString() ?? "";
    var emailSent = TempData["OtpEmailSentTo"]?.ToString();
    var devError  = TempData["DevOtpError"]?.ToString();
}

<div class="auth-page">
    <div class="auth-card" style="max-width:430px;">

        <div class="text-center mb-3">
            <div class="auth-crest">🔐</div>
            <h2>Verify Your Account</h2>
            <p class="subtitle">
                Enter the 6-digit OTP sent to your email<br/>
                <small class="text-muted">Mobile: <strong>+91 @mobile</strong></small>
            </p>
        </div>

        @* Email sent success banner *@
        @if (!string.IsNullOrEmpty(emailSent))
        {
            <div class="alert alert-success py-2 mb-3" style="font-size:.84rem;">
                <i class="fas fa-envelope-circle-check me-2"></i>
                OTP sent to <strong>@emailSent</strong> — check inbox &amp; spam.
            </div>
        }

        @* Dev mode: email failed, OTP is in console *@
        @if (!string.IsNullOrEmpty(devError))
        {
            <div class="alert mb-3" style="background:#fff8e1;border:1.5px solid #f59e0b;border-radius:10px;font-size:.82rem;padding:.9rem 1rem;">
                <div style="font-weight:700;color:#92400e;margin-bottom:4px;">
                    <i class="fas fa-triangle-exclamation me-1"></i> Email delivery failed
                </div>
                <div style="color:#78350f;margin-bottom:6px;">@devError</div>
                <div style="background:#fef3c7;border-radius:6px;padding:6px 10px;font-weight:700;color:#92400e;">
                    👉 Copy your OTP from the <strong>terminal / console window</strong> running dotnet.
                </div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3">
                <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
            </div>
        }
        @if (ViewBag.Info != null)
        {
            <div class="alert alert-info py-2 mb-3">
                <i class="fas fa-info-circle me-2"></i>@ViewBag.Info
            </div>
        }

        <form method="post" asp-action="VerifyOtp" id="otpForm">
            <div class="mb-4">
                <label class="form-label fw-semibold text-center d-block mb-3">
                    <i class="fas fa-shield-halved me-1 text-success"></i> Enter 6-Digit OTP
                </label>

                <div class="d-flex gap-2 justify-content-center my-2" id="otpBoxes">
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                    <input type="text" class="otp-box form-control text-center fw-bold" maxlength="1" inputmode="numeric" autocomplete="off" style="width:50px;height:56px;font-size:1.5rem;border:2px solid #ddd;border-radius:10px;" />
                </div>

                <input type="hidden" name="otpCode" id="otpCodeHidden" />

                <div class="form-text text-center mt-2">
                    <i class="fas fa-clock text-warning me-1"></i>
                    Expires in <strong id="countdown">10:00</strong>
                </div>
            </div>

            <button type="submit" class="btn btn-user w-100 py-2" id="verifyBtn">
                <i class="fas fa-check-circle me-2"></i>Verify &amp; Complete Registration
            </button>
        </form>

        <hr class="my-3" />

        <form method="post" asp-action="ResendOtp" class="text-center">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-rotate-right me-1"></i>Resend OTP
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/User/Register" style="font-size:.84rem;color:#aaa;">← Back to Register</a>
        </div>
    </div>
</div>

<style>
.otp-box:focus { border-color: var(--maroon) !important; box-shadow: 0 0 0 3px rgba(123,28,46,.15); outline: none; }
.otp-box.filled { border-color: #2e7d32 !important; background: #f0fff4; }
</style>

@section Scripts {
<script>
(function () {
    var boxes = Array.from(document.querySelectorAll('.otp-box'));

    boxes.forEach(function (box, idx) {
        box.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(-1);
            this.classList.toggle('filled', this.value !== '');
            if (this.value && idx < 5) boxes[idx + 1].focus();
            sync();
        });
        box.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !this.value && idx > 0) {
                boxes[idx - 1].value = '';
                boxes[idx - 1].classList.remove('filled');
                boxes[idx - 1].focus();
            }
        });
        box.addEventListener('paste', function (e) {
            e.preventDefault();
            var pasted = (e.clipboardData || window.clipboardData)
                .getData('text').replace(/\D/g, '').slice(0, 6);
            pasted.split('').forEach(function (ch, i) {
                if (boxes[i]) { boxes[i].value = ch; boxes[i].classList.add('filled'); }
            });
            boxes[Math.min(pasted.length, 5)].focus();
            sync();
        });
    });

    function sync() {
        document.getElementById('otpCodeHidden').value =
            boxes.map(function (b) { return b.value; }).join('');
    }

    document.getElementById('otpForm').addEventListener('submit', function (e) {
        sync();
        var code = document.getElementById('otpCodeHidden').value;
        if (code.length !== 6) {
            e.preventDefault();
            alert('Please enter all 6 digits.');
            return;
        }
        var btn = document.getElementById('verifyBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Verifying...';
        btn.disabled = true;
    });

    // 10 min countdown
    var secs = 600;
    var cd = document.getElementById('countdown');
    var timer = setInterval(function () {
        secs--;
        var m = Math.floor(secs / 60), s = secs % 60;
        cd.textContent = m + ':' + (s < 10 ? '0' : '') + s;
        if (secs <= 60) cd.style.color = '#dc3545';
        if (secs <= 0) { clearInterval(timer); cd.textContent = 'Expired'; }
    }, 1000);

    boxes[0].focus();
}());
</script>
}
